<Window x:Class="MdSnap.Editor.AnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MdSnap 标注" Background="{StaticResource DarkBgBrush}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 自绘标题栏。ResizeBorderThickness=6 只是最外圈 6px，画布有 12px 外边距，
         不会出现"在边上画画变成拖窗口"的问题。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- ===== 自绘标题栏 ===== -->
        <Border DockPanel.Dock="Top" Height="38" Background="{StaticResource DarkBarBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="MdSnap 标注" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource DarkTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Esc 关闭　Ctrl+C 复制　Ctrl+S 保存　Ctrl+Z 撤销"
                               FontSize="11" Foreground="{StaticResource DarkMutedBrush}"
                               VerticalAlignment="Center" Margin="14,1,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource DarkCaptionClose}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,7,0"
                        Click="Close_Click" ToolTip="关闭 (Esc)"/>
            </Grid>
        </Border>

        <!-- ===== 工具条 ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DarkToolbarBrush}" Padding="10,9"
                BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 输出动作放最左 -->
                <Button x:Name="CopyBtn" Content="复制" Style="{StaticResource DarkPrimary}" Click="Copy_Click" ToolTip="Ctrl+C"/>
                <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource DarkPrimary}" Click="Save_Click" ToolTip="Ctrl+S"/>
                <Button x:Name="CloseBtn" Content="关闭" Style="{StaticResource DarkAct}" Click="Close_Click" ToolTip="Esc"/>

                <Rectangle Width="1" Fill="{StaticResource DarkSepBrush}" Margin="9,3"/>

                <ToggleButton x:Name="TArrow" Content="箭头" Style="{StaticResource DarkTool}" Click="Tool_Click" Tag="Arrow"/>
                <ToggleButton x:Name="TRect" Content="矩形" Style="{StaticResource DarkTool}" Click="Tool_Click" Tag="Rect"/>
                <ToggleButton x:Name="TText" Content="文字" Style="{StaticResource DarkTool}" Click="Tool_Click" Tag="Text"/>
                <ToggleButton x:Name="THighlight" Content="高亮" Style="{StaticResource DarkTool}" Click="Tool_Click" Tag="Highlight"/>
                <ToggleButton x:Name="TMosaic" Content="马赛克" Style="{StaticResource DarkTool}" Click="Tool_Click" Tag="Mosaic"/>
                <ToggleButton x:Name="TEraser" Content="橡皮擦" Style="{StaticResource DarkTool}" Click="Tool_Click" Tag="Eraser"/>

                <Rectangle Width="1" Fill="{StaticResource DarkSepBrush}" Margin="9,3"/>
                <Button x:Name="UndoBtn" Content="撤销" Style="{StaticResource DarkAct}" Click="Undo_Click" ToolTip="Ctrl+Z"/>

                <Rectangle Width="1" Fill="{StaticResource DarkSepBrush}" Margin="9,3"/>
                <StackPanel x:Name="ColorBar" Orientation="Horizontal" VerticalAlignment="Center"/>

                <Rectangle Width="1" Fill="{StaticResource DarkSepBrush}" Margin="9,3"/>
                <Button x:Name="ThinBtn" Content="细" Style="{StaticResource DarkAct}" Click="Width_Click" Tag="2"/>
                <Button x:Name="MidBtn" Content="中" Style="{StaticResource DarkAct}" Click="Width_Click" Tag="4"/>
                <Button x:Name="ThickBtn" Content="粗" Style="{StaticResource DarkAct}" Click="Width_Click" Tag="8"/>

                <TextBlock x:Name="StatusText" Foreground="{StaticResource DarkMutedBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Stage">
                    <Image x:Name="BaseImage"/>
                    <!-- 擦除图层：橡皮擦把画面擦白，叠在底图之上、标注之下 -->
                    <Image x:Name="EraseImage" IsHitTestVisible="False"/>
                    <Canvas x:Name="AnnoCanvas" Background="Transparent"/>
                    <!-- 橡皮擦光标圈：不能被点击命中，否则会挡住 AnnoCanvas 的鼠标事件 -->
                    <Canvas x:Name="CursorLayer" Background="Transparent" IsHitTestVisible="False">
                        <Ellipse x:Name="EraserRing" Stroke="#FF0A78F0" StrokeThickness="1.5"
                                 Fill="#22FFFFFF" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>
