<Window x:Class="MdSnap.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MdSnap" Width="900" Height="640" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 自绘标题栏。用 WindowChrome 而不是 AllowsTransparency：
         这样系统级的拖动 / 缩放 / 双击最大化 / Win+方向键贴边 全部保留。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏 ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="MdSnap" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="极简无广告截图工具" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="9,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinBtn" Style="{StaticResource CaptionMin}" Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionMax}" Click="Maximize_Click" ToolTip="最大化 / 还原"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" Click="WindowClose_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：捕捉方式 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid Margin="14,18,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="捕捉方式" Style="{StaticResource SectionTitle}"/>

                    <ListBox Grid.Row="1" x:Name="ModeList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Tag="Full" AutomationProperties.Name="整个屏幕">
                            <StackPanel>
                                <TextBlock Text="整个屏幕" FontSize="13.5"/>
                                <TextBlock Text="截取全部显示器" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Window" AutomationProperties.Name="活动窗口">
                            <StackPanel>
                                <TextBlock Text="活动窗口" FontSize="13.5"/>
                                <TextBlock Text="截取当前前台窗口" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Region" AutomationProperties.Name="选定区域">
                            <StackPanel>
                                <TextBlock Text="选定区域" FontSize="13.5"/>
                                <TextBlock Text="拖框选择要截的部分" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Button Grid.Row="2" x:Name="CaptureBtn" Content="捕捉" Height="46" Margin="0,14,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Capture_Click"/>
                </Grid>
            </Border>

            <!-- 右：标签内容 -->
            <Grid Grid.Column="1" Margin="22,18,22,12">

                <!-- 工具 -->
                <StackPanel x:Name="PanelTools">
                    <TextBlock Text="快捷工具" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel Margin="0,0,0,4">
                        <Button Content="打开保存目录" Style="{StaticResource SecondaryButton}" Margin="0,0,9,9" Click="OpenDir_Click"/>
                        <Button Content="刷新历史" Style="{StaticResource SecondaryButton}" Margin="0,0,9,9" Click="RefreshHistory_Click"/>
                        <Button Content="打开设置" Style="{StaticResource SecondaryButton}" Margin="0,0,9,9" Click="OpenSettings_Click"/>
                        <Button Content="关于" Style="{StaticResource SecondaryButton}" Margin="0,0,9,9" Click="About_Click"/>
                        <Button Content="字体许可" Style="{StaticResource SecondaryButton}" Margin="0,0,9,9" Click="License_Click"/>
                    </WrapPanel>

                    <TextBlock Text="使用提示" Style="{StaticResource SectionTitle}" Margin="0,16,0,11"/>
                    <Border Style="{StaticResource Card}">
                        <TextBlock x:Name="ToolsGuideText" TextWrapping="Wrap" LineHeight="24"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                    </Border>

                    <TextBlock Text="当前配置" Style="{StaticResource SectionTitle}" Margin="0,16,0,11"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="快捷键" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ToolsHotkey" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="保存目录" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ToolsDir" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="保存格式" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ToolsFormat" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 历史 -->
                <Grid x:Name="PanelHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="捕捉历史" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Grid.Column="1" x:Name="HistoryCount" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="11,0,0,2"/>
                        <Button Grid.Column="2" Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshHistory_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                        <Grid>
                            <TextBlock x:Name="HistoryEmpty" Text="这里还没有截图。按快捷键或点「捕捉」开始吧。"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="HistoryList_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="9"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"
                                                            Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1.4">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                            <Setter TargetName="b" Property="BorderBrush" Value="#BFD9F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="152">
                                            <Border Background="{StaticResource BarBgBrush}" CornerRadius="8" Height="98">
                                                <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="5"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="1,7,0,0"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="1,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 热键 -->
                <StackPanel x:Name="PanelHotkey" Visibility="Collapsed">
                    <TextBlock Text="捕捉热键" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="选一个组合。若被其它程序占用，会提示注册失败。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                            <ListBox x:Name="HotkeyList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="HotkeyList_SelectionChanged"
                                     ItemContainerStyle="{StaticResource NavItem}"/>
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 存储 -->
                <StackPanel x:Name="PanelStorage" Visibility="Collapsed">
                    <TextBlock Text="保存设置" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="保存目录" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StorageDir" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                <Button Content="更改" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="ChangeDir_Click"/>
                                <Button Content="恢复桌面" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="ResetDir_Click"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" Margin="0,9,0,0"
                                       Text="每天自动在下面建一个以日期命名的子文件夹（如 20261008），截图不会直接堆在桌面。"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="保存格式" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                                <RadioButton x:Name="FmtPng" Content="PNG" GroupName="fmt" Margin="0,0,20,0" Click="Format_Click" Tag="png"/>
                                <RadioButton x:Name="FmtJpg" Content="JPG" GroupName="fmt" Margin="0,0,20,0" Click="Format_Click" Tag="jpg"/>
                                <RadioButton x:Name="FmtBmp" Content="BMP" GroupName="fmt" Click="Format_Click" Tag="bmp"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="文件命名" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Text="日期_序号，例如 20261008_001.png。序号按天递增且不会重号（删掉旧图也继续往下走，超过 999 自动变 4 位）。"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 底部标签 ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                    <RadioButton x:Name="TabTools" Content="工具" Style="{StaticResource TabButton}" IsChecked="True" Checked="Tab_Checked" Tag="Tools"/>
                    <RadioButton x:Name="TabHistory" Content="历史" Style="{StaticResource TabButton}" Checked="Tab_Checked" Tag="History"/>
                    <RadioButton x:Name="TabHotkey" Content="热键" Style="{StaticResource TabButton}" Checked="Tab_Checked" Tag="Hotkey"/>
                    <RadioButton x:Name="TabStorage" Content="存储" Style="{StaticResource TabButton}" Checked="Tab_Checked" Tag="Storage"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,5,14,5">
                    <Button Content="新手指南" Style="{StaticResource GhostButton}" Click="Guide_Click" Margin="0,0,4,0"/>
                    <Button x:Name="ExitBtn" Content="退出程序" Style="{StaticResource DangerButton}" Click="Exit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="3" Background="{StaticResource BarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="30">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusLeft" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="StatusRight" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
