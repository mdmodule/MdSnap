<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         字体
         内嵌 "MdSnap Sans SC"（思源黑体子集 + 按 OFL 改名版，可商用）。
         后面挂系统字体做兜底，万一缺字也不会出豆腐块。
         ============================================================ -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#MdSnap Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, MdSnap Sans SC</FontFamily>

    <!-- ============================================================
         颜色
         ============================================================ -->
    <Color x:Key="AccentColor">#0A78F0</Color>
    <Color x:Key="AccentHoverColor">#2B90FF</Color>
    <Color x:Key="AccentPressedColor">#0666CC</Color>
    <Color x:Key="DangerColor">#D93A34</Color>
    <Color x:Key="ShadowColor">#16233A</Color>

    <SolidColorBrush x:Key="PageBgBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#F1F5FA"/>
    <SolidColorBrush x:Key="BarBgBrush" Color="#EFF2F6"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E7EAF0"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#EFF2F6"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#59616E"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#99A1AE"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0A78F0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B90FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0666CC"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#DCEBFF"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#D93A34"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEB"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C42F29"/>

    <!-- ============================================================
         圆角 / 阴影（统一三档圆角，避免"各自为政"）
         ============================================================ -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusControl">9</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">7</CornerRadius>

    <DropShadowEffect x:Key="ShadowCard" x:Shared="False"
                      Color="{StaticResource ShadowColor}" BlurRadius="16" ShadowDepth="2"
                      Direction="270" Opacity="0.08" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="ShadowMenu" x:Shared="False"
                      Color="{StaticResource ShadowColor}" BlurRadius="20" ShadowDepth="4"
                      Direction="270" Opacity="0.16" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="ShadowAccent" x:Shared="False"
                      Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="3"
                      Direction="270" Opacity="0.30" RenderingBias="Quality"/>

    <!-- ============================================================
         卡片
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource AccentBrush}"
                            CornerRadius="{StaticResource RadiusControl}" Effect="{StaticResource ShadowAccent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次级按钮：白底 + 细边 + 悬浮上浮，替代原来像"禁用态"的浅框 -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusControl}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="13,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#BFD9F8"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoftHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 破坏性操作（退出程序）：默认克制、悬浮才"变红"并给出明确反馈 -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="13,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 电源图标：纯矢量，不依赖任何字体 -->
                            <Path x:Name="ico" Width="13" Height="13" Margin="0,0,7,0" Stretch="Uniform"
                                  Data="M11,2 A6,6 0 1 1 5,2 M8,1 L8,7"
                                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#F3C9C6"/>
                            <Setter TargetName="ico" Property="Stroke" Value="{StaticResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FADFDD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯文字按钮（保留给不重要的入口） -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" Padding="9,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         左侧导航条目
         ============================================================ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Padding="10,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="bar" Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource AccentBrush}" Opacity="0" Margin="0,2,9,2"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         底部标签
         ============================================================ -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" Padding="20,10">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                            <Rectangle x:Name="ink" VerticalAlignment="Bottom" Height="2.5" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource AccentBrush}" Opacity="0" Margin="6,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ink" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         文字层级
         ============================================================ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,11"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============================================================
         托盘右键菜单：全套自定义，摆脱系统默认的灰方块
         ============================================================ -->
    <Style x:Key="AppContextMenu" TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6"
                            Margin="10" Effect="{StaticResource ShadowMenu}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                       Margin="26,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource BorderSoftBrush}" Margin="10,5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 破坏性菜单项（退出）：静态红色，悬浮用红色系而不是蓝色 -->
    <Style x:Key="AppMenuItemDanger" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         自绘标题栏按钮（纯矢量图标，不依赖任何字体）
         ============================================================ -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>

    <Style x:Key="CaptionMin" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <Path x:Name="ico" Data="M0,0 H11" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.15"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E9EEF5"/>
                            <Setter TargetName="ico" Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#DCE3ED"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionMax" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="maxIco" Data="M0.5,0.5 H10.5 V10.5 H0.5 Z" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.15" SnapsToDevicePixels="True"/>
                            <Path x:Name="resIco" Data="M2.5,0.5 H10.5 V8.5 M0.5,2.5 H8.5 V10.5 H0.5 Z" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.15" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E9EEF5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#DCE3ED"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter TargetName="maxIco" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="resIco" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <Path x:Name="ico" Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.15" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E5484D"/>
                            <Setter TargetName="ico" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C93B40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         深色区（标注编辑器 / 取景覆盖层）
         ============================================================ -->
    <SolidColorBrush x:Key="DarkBgBrush" Color="#17191C"/>
    <SolidColorBrush x:Key="DarkBarBrush" Color="#212429"/>
    <SolidColorBrush x:Key="DarkToolbarBrush" Color="#1D2126"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#2E333A"/>
    <SolidColorBrush x:Key="DarkTextBrush" Color="#E6E9EE"/>
    <SolidColorBrush x:Key="DarkMutedBrush" Color="#8B94A0"/>
    <SolidColorBrush x:Key="DarkBtnBrush" Color="#2A2F36"/>
    <SolidColorBrush x:Key="DarkBtnHoverBrush" Color="#353B44"/>
    <SolidColorBrush x:Key="DarkBtnPressedBrush" Color="#414852"/>
    <SolidColorBrush x:Key="DarkAccentTextBrush" Color="#8AB4F8"/>
    <SolidColorBrush x:Key="DarkSepBrush" Color="#2E333A"/>

    <!-- 取景覆盖层：浮在压暗的冻结截屏之上的半透明控件 -->
    <SolidColorBrush x:Key="OverlayBtnBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBtnHoverBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="OverlayBtnPressedBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="OverlayPanelBrush" Color="#F2212429"/>
    <SolidColorBrush x:Key="OverlayPanelBorderBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="OverlaySepBrush" Color="#3AFFFFFF"/>
    <SolidColorBrush x:Key="OverlayLabelBrush" Color="#A8B0BC"/>
    <SolidColorBrush x:Key="OverlayHintBrush" Color="#E8FFFFFF"/>

    <!-- 文字描边：让提示语压在任何底图（纯白/纯黑）上都读得清 -->
    <DropShadowEffect x:Key="ShadowText" x:Shared="False"
                      Color="#000000" BlurRadius="7" ShadowDepth="0" Opacity="0.9" RenderingBias="Quality"/>

    <Style x:Key="DarkTool" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{StaticResource DarkBtnBrush}"
                            CornerRadius="{StaticResource RadiusControl}" Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource DarkBtnHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 注意：这里**故意不在悬浮态设 Foreground** ——
         粗细档位是靠代码直接赋 btn.Foreground 表示选中的，样式里再设会打架。 -->
    <Style x:Key="DarkAct" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource DarkBtnBrush}"
                            CornerRadius="{StaticResource RadiusControl}" Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource DarkBtnHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource DarkBtnPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkPrimary" TargetType="Button" BasedOn="{StaticResource DarkAct}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource AccentBrush}"
                            CornerRadius="{StaticResource RadiusControl}" Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkCaptionClose" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}">
                        <Path x:Name="ico" Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5"
                              Stroke="{StaticResource DarkMutedBrush}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E5484D"/>
                            <Setter TargetName="ico" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C93B40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
