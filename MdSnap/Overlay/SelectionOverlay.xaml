<Window x:Class="MdSnap.Overlay.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MdSnap"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" Cursor="Cross"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- 动作按钮（确定 / 取消）：尺寸与内边距跟标注编辑器保持一致 -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource OverlayBtnBrush}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource OverlayBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource OverlayBtnPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模式开关。注意 IsChecked 的触发器放在 IsMouseOver 之后 ——
             同时命中时后写的赢，选中态这样才不会被悬浮态冲掉。 -->
        <Style x:Key="TbToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource OverlayBtnBrush}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource OverlayBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource OverlayBtnPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 全黑底：让压暗的底图有实体背景 -->
        <Rectangle Fill="#000000"/>

        <!-- 冻结的整屏截图（压暗显示） -->
        <Rectangle x:Name="BackdropImage" Opacity="0.42">
            <Rectangle.Fill>
                <ImageBrush x:Name="FullBrush" Stretch="Fill"/>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas x:Name="Surface" Background="Transparent">
            <!-- 选区：以原亮度显示冻结图里的对应裁片 -->
            <Rectangle x:Name="Crop" Visibility="Collapsed">
                <Rectangle.Fill>
                    <ImageBrush x:Name="CropBrush" Stretch="Fill" ViewboxUnits="RelativeToBoundingBox"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 选区边框 + 四角把手。
                 把手改成「白心 + 主色描边」——纯主色实心在浅色截图上几乎看不见。 -->
            <Rectangle x:Name="SelBorder" Visibility="Collapsed" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="1.5" Fill="Transparent" IsHitTestVisible="False"/>
            <Rectangle x:Name="H_TL" Width="9" Height="9" Fill="White" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="H_TR" Width="9" Height="9" Fill="White" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="H_BL" Width="9" Height="9" Fill="White" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="H_BR" Width="9" Height="9" Fill="White" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- 尺寸角标：不透明主色 + 浅描边，压在浅色底图上也能读 -->
            <Border x:Name="SizeBadge" Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusSmall}"
                    BorderBrush="#80FFFFFF" BorderThickness="1" Padding="9,4" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="13" FontFamily="{StaticResource MonoFont}"/>
            </Border>

            <!-- 未开始拖拽时的提示（加一圈暗描边，任何底图上都清晰） -->
            <TextBlock x:Name="Hint" Text="拖拽鼠标框选区域　·　双击 = 全屏　·　Esc = 取消"
                       Foreground="{StaticResource OverlayHintBrush}" FontSize="16"
                       Effect="{StaticResource ShadowText}" IsHitTestVisible="False"/>

            <!-- 顶部/跟随选区的工具条 -->
            <Border x:Name="Toolbar" Background="{StaticResource OverlayPanelBrush}"
                    BorderBrush="{StaticResource OverlayPanelBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}" Padding="9,7" Effect="{StaticResource ShadowMenu}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="模式" Foreground="{StaticResource OverlayLabelBrush}" FontSize="12"
                               Margin="7,0,9,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="BtnRegion" Content="区域拖框" Style="{StaticResource TbToggle}" IsChecked="True" Click="BtnRegion_Click"/>
                    <ToggleButton x:Name="BtnWindow" Content="活动窗口" Style="{StaticResource TbToggle}" Click="BtnWindow_Click"/>
                    <ToggleButton x:Name="BtnFull" Content="全屏" Style="{StaticResource TbToggle}" Click="BtnFull_Click"/>
                    <Rectangle Width="1" Fill="{StaticResource OverlaySepBrush}" Margin="10,4"/>
                    <TextBlock x:Name="InfoText" Text="拖拽选择区域" Foreground="{StaticResource OverlayLabelBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="2,0,14,0"/>
                    <Button x:Name="BtnOk" Content="确定" Style="{StaticResource TbBtn}" Click="BtnOk_Click"/>
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource TbBtn}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
